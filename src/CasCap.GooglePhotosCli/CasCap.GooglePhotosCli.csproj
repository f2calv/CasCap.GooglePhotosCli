<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>googlephotos</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Google Photos CLI Tool</Description>
    <PackAsTool>true</PackAsTool>
    <PackageTags>google,photos,command line interface,cli,backup,sync,tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BetterConsoleTables" />
    <PackageReference Include="CasCap.Api.GooglePhotos" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ShellProgressBar" />
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" />
    <PackageReference Include="McMaster.Extensions.Hosting.CommandLine" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="CasCap.Common.Caching" />
  </ItemGroup>

</Project>